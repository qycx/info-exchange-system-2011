/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

ForMgrBar_IDR_MAINFRAME MENU
BEGIN
    POPUP "??(&G)"
    BEGIN
        POPUP "????(&N)\tCtrl+N"
        BEGIN
            MENUITEM "????(&B)",                    ID_NEWBARLISTMON
            MENUITEM "?????(&S)",                   ID_NEWPCLISTMON
            MENUITEM "??(??)??(&Z)",                ID_NEWSITELISTMON
            MENUITEM "?????(&J)",                   ID_NEWKEYLISTMON
        END
        MENUITEM "??(&O)...\tCtrl+O",           ID_FILE_OPEN
        MENUITEM SEPARATOR
        MENUITEM "????(&R)...",                 ID_FILE_PRINT_SETUP
        MENUITEM SEPARATOR
        MENUITEM "????",                        ID_FILE_MRU_FILE1, GRAYED
        MENUITEM SEPARATOR
        MENUITEM "??(&X)",                      ID_APP_EXIT
    END
    POPUP "??(&V)"
    BEGIN
        MENUITEM "???(&T)",                     ID_VIEW_TOOLBAR
        MENUITEM "???(&S)",                     ID_VIEW_STATUS_BAR
        MENUITEM "???(&M)",                     ID_VIEW_MC_BAR
        MENUITEM "??(&P)",                      ID_WINDOW_SPLIT
        MENUITEM SEPARATOR
        MENUITEM "???(&G)",                     ID_VIEW_LARGEICON
        MENUITEM "???(&M)",                     ID_VIEW_SMALLICON
        MENUITEM "??(&L)",                      ID_VIEW_LIST
        MENUITEM "????(&D)",                    ID_VIEW_DETAILS
        MENUITEM SEPARATOR
        POPUP "???? (&I)"
        BEGIN
            MENUITEM "??? (&N)",                    ID_VIEW_BYNAME
            MENUITEM SEPARATOR
            MENUITEM "????(&A)",                    ID_VIEW_AUTOARRANGE
        END
        MENUITEM "????(&E)",                    ID_VIEW_LINEUP
    END
    POPUP "??(&H)"
    BEGIN
        MENUITEM "?? qyMc(&A)...",              ID_APP_ABOUT
    END
    POPUP "test"
    BEGIN
        MENUITEM "for test",                    ID_TEST
        MENUITEM "modifyVar",                   ID_testModifyVar
    END
    POPUP "?????????"
    BEGIN
        MENUITEM "????",                        ID_NEWBARMON
    END
    POPUP "??(&P)"
    BEGIN
        MENUITEM "????(&R)",                    ID_CFG_LOGTRANSFER
        MENUITEM "???????(&J)",                 ID_CFG_KEYLIST
        MENUITEM SEPARATOR
        MENUITEM "????????(&G)",                ID_CFG_SJ
        MENUITEM "??????(&B)",                  ID_CFG_BARINFO
        MENUITEM SEPARATOR
        MENUITEM "??????",                      ID_CFG_TERMS
        MENUITEM SEPARATOR

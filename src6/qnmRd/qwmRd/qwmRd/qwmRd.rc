IDD_PROPERTIES DIALOG DISCARDABLE  0, 0, 203, 121
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_3DLOOK | DS_CENTER | 
    WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "Property Page"
FONT 8, "Tahoma"
BEGIN
    PUSHBUTTON      "&Cancel",IDCANCEL,132,84,55,15
    DEFPUSHBUTTON   "&OK",IDOK,17,84,55,15
    GROUPBOX        "Incoming Connections",IDC_CONNECT_BORDER,5,15,10,75
    CONTROL         "Accept Socket Connections(test)",IDC_CONNECT_SOCK,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,15,10,15
    CONTROL         "Enable CORBA",IDC_CONNECT_CORBA,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,60,10,15
    EDITTEXT        IDC_PORTNO,5,48,6,15,ES_AUTOHSCROLL | ES_NUMBER
    EDITTEXT        IDC_PASSWORD,5,25,6,15,ES_PASSWORD | ES_AUTOHSCROLL
    GROUPBOX        "Update Handling",IDC_UPDATE_BORDER,17,70,169,45
    CONTROL         "Poll Full Screen",IDC_POLL_FULLSCREEN,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,20,65,100,20
    CONTROL         "Poll Console Windows Only",IDC_CONSOLE_ONLY,"Button",
                    BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP,120,60,60,20
    CONTROL         "Poll Foreground Window",IDC_POLL_FOREGROUND,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,20,70,100,20
    CONTROL         "Poll Window Under Cursor",IDC_POLL_UNDER_CURSOR,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,25,68,100,22
    CONTROL         "Poll On Event Received Only",IDC_ONEVENT_ONLY,"Button",
                    BS_AUTOCHECKBOX | BS_MULTILINE | WS_TABSTOP,120,60,60,20
    CONTROL         "Disable Remote Keyboard && Pointer",IDC_DISABLE_INPUTS,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,5,15,8,15
    PUSHBUTTON      "&Apply",IDC_APPLY,5,52,10,8
    CONTROL         "Disable Local Keyboard && Pointer",
                    IDC_DISABLE_LOCAL_INPUTS,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,27,15,8,15
    GROUPBOX        "Connection Settings",IDC_CONNSETTINGS_BORDER,5,15,8,50
    CONTROL         "Remove Desktop Wallpaper",IDC_REMOVE_WALLPAPER,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,5,15,8,45
    LTEXT           "Password:",IDC_PASSWORD_LABEL,20,15,8,15,SS_CENTERIMAGE
    CONTROL         "Enable Java Viewer",IDC_CONNECT_HTTP,"Button",
                    BS_AUTOCHECKBOX | WS_TABSTOP,10,70,10,15
    GROUPBOX        "When Last Client Disconnects",IDC_LOCKSETTINGS,5,95,10,
                    20
    CONTROL         "Do Nothing",IDC_LOCKSETTING_NOTHING,"Button",
                    BS_AUTORADIOBUTTON | WS_GROUP | WS_TABSTOP,5,60,10,16
    CONTROL         "Logoff Workstation",IDC_LOCKSETTING_LOGOFF,"Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP,5,44,10,16
    CONTROL         "Lock Workstation",IDC_LOCKSETTING_LOCK,"Button",
                    BS_AUTORADIOBUTTON | WS_TABSTOP,5,65,10,16
    LTEXT           "Display Number:",IDC_DISPLAY_NO_LABEL,20,57,8,8,
                    SS_CENTERIMAGE
    CONTROL         "Auto",IDC_AUTO_DISPLAY_NO,"Button",BS_AUTOCHECKBOX | 
                    WS_TABSTOP,5,57,10,8
    CONTROL         "Prompt to accept remote desktop",
                    IDC_RADIO_promptToAccept,"Button",BS_AUTORADIOBUTTON,32,
                    16,143,15
    CONTROL         "Remote desktop automatically",IDC_RADIO_autoAccept,
                    "Button",BS_AUTORADIOBUTTON,32,37,145,14
END

IDD_ABOUT DIALOG DISCARDABLE  0, 0, 336, 108
STYLE DS_MODALFRAME | DS_SETFOREGROUND | DS_CENTER | WS_POPUP | WS_CAPTION | 
    WS_SYSMENU
CAPTION "About WinVNC"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,249,80,80,20
    CONTROL         132,IDC_VNCLOGO,"Static",SS_BITMAP | SS_CENTERIMAGE | 
                    SS_SUNKEN,7,5,83,75
    LTEXT           "WinVNC Version 3.3.7",IDC_VERSION,100,9,229,11
    LTEXT           "by James Weatherall",IDC_NAME,100,20,229,10
    LTEXT           "Virtual Network Computing",IDC_VNC,100,50,229,10
    LTEXT           "For more information, see http://www.realvnc.com/",
                    IDC_WWW,100,60,229,10
    LTEXT           "Copyright 1997-2001 - AT&&T Labs Cambridge",
                    IDC_COPYRIGHT,7,90,233,10
    LTEXT           "Copyright 2002-2003 - RealVNC Ltd.",IDC_TRADEMARK,7,80,
                    233,10
    LTEXT           "Build",IDC_BUILDTEXT,100,30,20,10
    LTEXT           "BuildTime",IDC_BUILDTIME,120,30,209,10
END

IDD_ACCEPT_CONN DIALOG DISCARDABLE  0, 0, 186, 95
STYLE DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_VISIBLE | WS_CAPTION
CAPTION "Accept WinVNC Connection?"
FONT 8, "MS Sans Serif"
BEGIN
    DEFPUSHBUTTON   "&Accept",IDACCEPT,7,74,53,14
    PUSHBUTTON      "&Reject",IDREJECT,130,74,49,14
    CTEXT           "WinVNC has received an incoming connection from",
                    IDC_STATIC_TEXT1,7,7,172,17,SS_CENTERIMAGE
    CTEXT           "<unknown host>",IDC_ACCEPT_IP,7,30,172,16,
                    SS_CENTERIMAGE
    CTEXT           "Do you wish to Accept or Reject the connection?",
                    IDC_STATIC_TEXT,7,50,172,15,SS_CENTERIMAGE
    CTEXT           "AutoReject:",IDC_ACCEPT_TIMEOUT,60,74,70,14,
                    SS_CENTERIMAGE
END



/////////////////////////////////////////////////////////////////////////////
// CQyBulkset

IMPLEMENT_DYNAMIC(CQyBulkset, CRecordset)

CQyBulkset::CQyBulkset(CDatabase* pdb)
	: CRecordset(pdb)
{
	//{{AFX_FIELD_INIT(CQyBulkset)
	//}}AFX_FIELD_INIT
	m_nDefaultType = snapshot;
	m_ppvData = NULL;
	m_ppvLengths = NULL;
}

CQyBulkset::~CQyBulkset(  )
{
	if  (  m_ppvData  )  delete [] m_ppvData;
	if  (  m_ppvLengths  )  delete []  m_ppvLengths;

}

 int  CQyBulkset::Initialize(  unsigned int nFields,  QY_COLUMNINFO * pColumns  )
{
	int					iErr	=	-1;
	void			*	pVar	=	NULL;
	
	if  (  nFields > QY_MAXCOLS  )  return  -1;
	

	for  (  m_nFields  =  0;  m_nFields  <  nFields;  m_nFields  ++  )  {
		m_arrayName.Add(  pColumns[m_nFields].label  );
		m_nColsWidth[m_nFields]  =  max(  pColumns[m_nFields].nMaxBytes, lstrlen(  pColumns[m_nFields].label  )  );
		
		// data types defined in sql.h and sqlext.h
		m_nDataType[m_nFields]  =  pColumns[m_nFields].iDataType;
	}

	m_ppvData = new void*[m_nFields];
	if  (  !m_ppvData  )	goto  errLabel;
	memset(m_ppvData, 0, sizeof(void*) * m_nFields);
	m_ppvLengths = new void*[m_nFields];
	if  (  !m_ppvLengths  )  goto  errLabel;
	memset(m_ppvLengths, 0, sizeof(void*) * m_nFields);
	
	iErr	=	0;

errLabel:

	return  iErr;

}


void CQyBulkset::Close()
{
	CRecordset::Close();

	delete [] m_ppvData;	m_ppvData		=  NULL;
	delete [] m_ppvLengths;	m_ppvLengths	=  NULL;
}

CString CQyBulkset::GetDefaultConnect()
{
	return _T("ODBC;DSN=");
}

CString CQyBulkset::GetDefaultSQL()
{
	return _T("");
}



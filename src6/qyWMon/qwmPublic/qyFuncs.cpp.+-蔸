extern "C" int debugLog(char *fmt,...);



//  将qyUsrTab中的数据导出到文件中
 int  LoadDBUsrs(  CDatabase  *  pDb,  CString  name  ) 
{
	int			iErr			=	-1;		
	FILE	*	fp				=	NULL;
	char		buf[1024];
	CString		sKeyword, sContext, tmpStr;
	CDBVariant	varValue;
	int			index, nField;
	char		cSpace			=	0x20;
	
	CRecordset ls( pDb );

	if  ( !(  fp  =  fopen(  name,  "w"  )  )  )  {
		//  debugLog( "" );
		goto errLabel;
	}
		
	TRY{		
		if( !ls.Open( CRecordset::forwardOnly, _T( "SELECT name,passwd FROM qyUsrTab" ) ) ){
			debugLog( "LoadDBUsrs() open() failed." );
			goto errLabel;
		}
		}
	CATCH  (  CDBException,  e  )  {
		debugLog( "LoadDBLog() caught err is:%s", e->m_strError );
		goto errLabel;
	}
	END_CATCH

	nField = ls.GetODBCFieldCount( );
	while  (  !ls.IsEOF(  )  ) 	{	

		   memset( buf, 0, sizeof( buf ) );
		   for  (  index  = 0;  index  <  nField;  index  ++  )  {
				TRY  {
				 	 ls.GetFieldValue(  index,  varValue  );
				 	 tmpStr  =  varValue.m_pstring->GetBuffer(  0  );
			 		}
			 	CATCH(  CDBException,  e  )  {			
				 	  break;				
			 		}
			 	END_CATCH
		
			 	switch  (  index  )  {
						case 0:
							   sprintf( buf, "%s%s", tmpStr, "$");		
							   break;
						case 1:
							   sprintf( buf, "%s%s%s", buf, tmpStr, "$");				
							   break;
			 			default:			
								break;
				}			
		   }

		   if( fprintf( fp, "%s\n", buf ) < 0 ) goto errLabel;
		   
		   ls.MoveNext( );

	}

	iErr = 0;

errLabel:

	if  (  ls.IsOpen(  )  )  ls.Close( );

	if  (  fp  )  {  fclose(  fp  );  fp  =  NULL;  }

	return iErr;		

}



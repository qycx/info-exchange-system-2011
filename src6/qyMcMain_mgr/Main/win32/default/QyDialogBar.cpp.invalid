 LRESULT CQyDialogBar::OnQyComm( WPARAM wParam, LPARAM lParam )
 {
	 LONG				lRet	=  -1;
	 QY_WMBUF_COMM	*	pComm	=	(  QY_WMBUF_COMM  *  )lParam;
	 
	 if  (  pComm->uiType  !=  QY_WMPARAM_TELLDOCINFO  &&  pComm->uiType  !=  QY_WMPARAM_UPDATEBAR )  goto  errLabel;
	 
	 if  (  pComm->uiType  ==  QY_WMPARAM_TELLDOCINFO  )  {
		 m_pBarCfg  =  (  BAR_CFG  *  )pComm->u.tellDocInfo.pBarCfg;	 		 
		 if  (  m_pBarCfg  )  {
#if  0
			 int  i;
			 for  (  i  =  0;  i  <  m_pBarCfg->n;  i  ++  )  {
				 this->m_btn[i].ShowWindow(  SW_NORMAL  );
				 this->m_btn[i].SetWindowText(  CString(  m_pBarCfg->btns[i].name  )  );
			 }
			 for  (  ;  i  <  NUM_BARBTNS;  i  ++  )  {
				 this->m_btn[i].ShowWindow(  SW_HIDE  );
			 }
#endif
		 }
	 }
	 
	 lRet  =  QY_RC_WMOK;

errLabel:
 
	 return  lRet;
	 
}



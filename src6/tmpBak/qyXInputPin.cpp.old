		pMediaType->InitMediaType(  );
		pMediaType->SetType(  &MEDIATYPE_Video  );
		//  pMediaType->SetSubtype(  &TIME_FORMAT_NONE  );
		pMediaType->SetSubtype(  &WMCMEDIASUBTYPE_WMV3  );

/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDI_QYTRAY              ICON    DISCARDABLE     "qyTray.ICO"
IDI_SMALL               ICON    DISCARDABLE     "SMALL.ICO"
IDI_SERVICENOTRESPOND   ICON    DISCARDABLE     "icon1.ico"
IDI_SERVICENOTAVAIL     ICON    DISCARDABLE     "ico00001.ico"
IDI_TRAYICON            ICON    DISCARDABLE     "ico00002.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDC_QYTRAY MENU DISCARDABLE 
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "E&xit",                       IDM_EXIT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About ...",                  IDM_ABOUT
    END
END

IDM_TASKBARMENU MENU DISCARDABLE 
BEGIN
    POPUP "qyTray"
    BEGIN
        MENUITEM "&help",                       ID_HELP_TOPICS
    END
END

IDM_TASKBARMENUREV MENU DISCARDABLE 
BEGIN
    MENUITEM "qyTray",                      65535
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDC_QYTRAY ACCELERATORS MOVEABLE PURE 
BEGIN
    "?",            IDM_ABOUT,              ASCII,  ALT
    "/",            IDM_ABOUT,              ASCII,  ALT
END


/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOG DISCARDABLE  22, 17, 230, 75
STYLE DS_MODALFRAME | WS_CAPTION | WS_SYSMENU
CAPTION "About"
FONT 8, "System"
BEGIN
    ICON            IDI_QYTRAY,IDC_MYICON,14,9,16,16
    LTEXT           "qyTray Version 1.0",IDC_STATIC,49,10,119,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2002",IDC_STATIC,49,20,119,8
    DEFPUSHBUTTON   "OK",IDOK,195,6,30,11,WS_GROUP
END



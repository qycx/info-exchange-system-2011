IDR_MAINFRAME MENU
BEGIN
    POPUP "View(&V)"
    BEGIN
        MENUITEM "Toolbar(&T)",                 ID_VIEW_TOOLBAR
        MENUITEM "Statusbar(&S)",               ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "Refresh(&R)  F5",             ID_qyRefresh
    END
    POPUP "Help(&H)"
    BEGIN
        MENUITEM "How Do I(&D)",                ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "About QyMc(&A)...",           ID_APP_ABOUT
    END
END



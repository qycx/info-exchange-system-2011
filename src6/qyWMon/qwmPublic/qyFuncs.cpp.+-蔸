		while  (  buf[i]  !=  '$'  )  {
			   passwdBuf[i - k] = buf[i];
			   i  ++  ;
		}
		passwdBuf[i - k] = '\0';
		
		sprintf(  buf, "INSERT INTO qyUsrTab( name, passwd ) VALUES( \'%s\', \'%s\' )",  usrNameBuf,  passwdBuf  );

 int  SaveDBGrpUsrRelations( char * dsnName, CString name )
{
	int			iErr			=			-1;
	int			i, k;
	FILE	*	fp				=			NULL;
	char		buf[256];
	CDatabase	pDb;
	char		grpNameBuf[256];
	char		usrNameBuf[256];  
	
	if  ( ( fp = fopen( name, "r" ) ) == NULL )  {
		debugLog( "SaveProVer(): fopen() failed." );
	 	goto errLabel;
	}

	TRY{
		if( !pDb.Open( dsnName ) )
			goto errLabel;
	}
	CATCH( CDBException, e ) {
		debugLog( "SaveProVer( ) caught err is:%s", e->m_strError );
		goto errLabel;
	}
	END_CATCH

	while ( 1 ) {		
		memset( buf, 0, sizeof( buf ) );
		if( !fgets( buf, sizeof( buf ), fp ) ) break;

		i  =  0;
		memset(  grpNameBuf,  0,  sizeof(  grpNameBuf  )  );
		while  (  buf[i]  !=  '$'  )  {
			   grpNameBuf[i] = buf[i];
			   i ++;
		}
		grpNameBuf[i] = '\0';

		i  ++  ;
		k  =  i;
		memset(  usrNameBuf,  0,  sizeof(  usrNameBuf  )  );
		while  (  buf[i]  !=  '$'  )  {
			   usrNameBuf[i - k] = buf[i];
			   i  ++  ;
		}
		usrNameBuf[i - k] = '\0';
		
		sprintf(  buf, "INSERT INTO qyGrpUsrRelationTab( grpName, usrName ) VALUES( \'%s\', \'%s\' )",  grpNameBuf,  usrNameBuf  );
		TRY{
			pDb.ExecuteSQL( buf );
		}
		CATCH( CDBException, e ){
			debugLog( "SaveDBGrpUsrRelations() caught err is:%s", e->m_strError );
			continue;
		}
		END_CATCH		
	}

	iErr = 0;
	
errLabel:

	if( pDb.IsOpen() )	pDb.Close();

	if ( fp ) { fclose( fp ); fp = NULL; }

	DeleteFile( name );

	return iErr;

}


 int SaveDBUsrs( char *dsnName, CString name )
{
	int			iErr			=			-1;
	int			i, k;
	FILE	*	fp				=			NULL;
	char		buf[256];
	CDatabase	pDb;
	char		usrNameBuf[256];  
	char		passwdBuf[256];

	if  ( ( fp = fopen( name, "r" ) ) == NULL )  {
		debugLog( "SaveProVer(): fopen() failed." );
	 	goto errLabel;
	}

	TRY{
		if( !pDb.Open( dsnName ) )
			goto errLabel;
	}
	CATCH( CDBException, e ) {
		debugLog( "SaveProVer( ) caught err is:%s", e->m_strError );
